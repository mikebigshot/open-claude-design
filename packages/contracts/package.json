{
  "name": "@open-design/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./chat": "./src/chat.ts",
    "./files": "./src/files.ts",
    "./projects": "./src/projects.ts"
  },
  "scripts": {
    "build": "tsc -b",
