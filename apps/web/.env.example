# Web SPA build-time env vars. Copy to .env.local (gitignored) and edit.

# When the worker lives at a different origin than the SPA (cross-domain
# deploy, e.g. Pages on design.example.com talking to a worker at
# design-api.example.com), set this to the worker's full URL.
# Leave empty when the SPA is served by the same origin (default — Pages
# Functions or Cloudflare Routes proxy /api/* to the worker).
VITE_API_BASE=

# When `true`, PreviewPanel points the iframe runtime at same-origin
# /vendor/* paths instead of unpkg.com. Required for offline / strict-CSP
# production deploys. Run `npm run vendor` once to populate the bundles.
VITE_VENDOR_RUNTIME=false
