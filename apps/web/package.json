{
  "name": "@open-design/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "vendor": "node scripts/fetch-vendor.mjs",
    "vendor:force": "node scripts/fetch-vendor.mjs --force",
    "clean": "rm -rf dist .turbo node_modules/.vite"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/cerebras": "^2.0.49",
    "@ai-sdk/cohere": "^3.0.33",
    "@ai-sdk/deepseek": "^2.0.32",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/groq": "^3.0.38",
    "@ai-sdk/mistral": "^3.0.33",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@ai-sdk/react": "^3.0.174",
    "@ai-sdk/vercel": "^2.0.47",
    "@ai-sdk/xai": "^3.0.87",
    "@babel/parser": "7.29.3",
    "@babel/types": "7.29.0",
    "@open-design/contracts": "*",
    "@open-design/design-tokens": "*",
    "@open-design/iframe-runtime": "*",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.172",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.27.0",
    "styled-components": "^6.1.13",
    "yaml": "^2.8.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
