{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "outDir": "dist",
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@open-design/contracts": ["../../packages/contracts/src/index.ts"],
      "@open-design/contracts/*": ["../../packages/contracts/src/*"],
      "@open-design/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@open-design/design-tokens/*": ["../../packages/design-tokens/src/*"],
      "@open-design/iframe-runtime": ["../../packages/iframe-runtime/src/index.ts"],
      "@open-design/iframe-runtime/*": ["../../packages/iframe-runtime/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/design-tokens" },
    { "path": "../../packages/iframe-runtime" }
  ]
}
